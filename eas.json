{
  "cli": {
    "version": ">= 18.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "pnpm": "9.15.9",
      "workingDirectory": "artifacts/mobile"
    },
    "preview": {
      "distribution": "internal",
      "pnpm": "9.15.9",
      "workingDirectory": "artifacts/mobile",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "pnpm": "9.15.9",
      "workingDirectory": "artifacts/mobile",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
